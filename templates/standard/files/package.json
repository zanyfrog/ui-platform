{
  "name": "{{APP_KEY}}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:services && tsc --noEmit && vite build",
    "build:services": "npm run build --workspace @ui-app/app-services",
    "start": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@ui-app/app-services": "file:packages/app-services"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
