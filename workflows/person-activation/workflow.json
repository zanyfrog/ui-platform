    { "id": "notify", "type": "service", "service": "reference.notification", "input": { "from": "context", "path": ["primaryRecordId"] } },
    { "id": "activation-history", "type": "crud", "datasetId": "dataset-person-form-reference", "operation": "insert", "records": { "fields": {
