{
  "name": "ui-platform",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "UI application creation, discovery, preview, settings, export, deletion, and maintenance platform.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @uib/platform-core && npm run build --workspace @ui-platform/artifacts && vite build && tsc -p tsconfig.server.json",
    "checkin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-in.ps1",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p packages/platform-core/tsconfig.json && npm run typecheck --workspace @ui-platform/artifacts",
    "preuib": "npm run build --workspace @ui-platform/artifacts",
    "uib": "node packages/artifacts/dist/cli.js",
    "test": "vitest run",
    "predev:api": "npm run build --workspace @uib/platform-core",
    "dev:api": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@ui-base/assets": "file:../ui-base/packages/ui-base-assets",
    "@ui-base/calendar": "file:../ui-base/packages/ui-base-calendar",
    "@ui-base/core": "file:../ui-base/packages/ui-base-core",
    "@ui-base/design-system": "file:../ui-base/packages/ui-base-design-system",
    "@ui-base/forms": "file:../ui-base/packages/ui-base-forms",
    "@ui-base/hero": "file:../ui-base/packages/ui-base-hero",
    "@ui-base/icons": "file:../ui-base/packages/ui-base-icons",
    "@ui-base/theme": "file:../ui-base/packages/ui-base-theme",
    "@ui-base/tour-ui": "file:../ui-base/packages/ui-base-tour-ui",
    "@ui-base/ui": "file:../ui-base/packages/ui-base-ui",
    "@ui-base/ui-layout": "file:../ui-base/packages/ui-layout",
    "@uib/platform-core": "file:packages/platform-core",
    "build": "^0.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=18"
  }
}
