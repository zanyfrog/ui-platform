{
  "name": "@ui-platform/artifacts",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared artifact source bundles, validation, transactional saves and filesystem watching.",
  "types": "./dist/index.d.ts",
  "exports": {
    "./storage": {
      "types": "./dist/storage-api.d.ts",
      "import": "./dist/storage-api.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validation": {
      "types": "./dist/validation/validator-registry.d.ts",
      "import": "./dist/validation/validator-registry.js"
    }
  },
  "bin": {
    "uib": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ui-platform/i-am": "file:../../../UI Platform Data Services/packages/i-am",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
