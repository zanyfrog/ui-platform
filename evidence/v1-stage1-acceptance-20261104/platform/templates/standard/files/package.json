{
  "name": "{{APP_KEY}}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:services && tsc --noEmit && vite build",
    "build:services": "npm run build --workspace @ui-app/app-services",
    "start": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@ui-app/app-services": "file:packages/app-services",
    "@ui-platform/visual-artifacts": "file:{{PLATFORM_PACKAGES}}/visual-artifacts",
    "@uib/platform-core": "file:{{PLATFORM_PACKAGES}}/platform-core",
    "@ui-base/core": "file:{{UI_BASE_PACKAGES}}/ui-base-core",
    "@ui-base/ui": "file:{{UI_BASE_PACKAGES}}/ui-base-ui",
    "@ui-base/forms": "file:{{UI_BASE_PACKAGES}}/ui-base-forms",
    "@ui-base/hero": "file:{{UI_BASE_PACKAGES}}/ui-base-hero",
    "@ui-base/ui-layout": "file:{{UI_BASE_PACKAGES}}/ui-layout",
    "@ui-base/theme": "file:{{UI_BASE_PACKAGES}}/ui-base-theme",
    "@ui-base/design-system": "file:{{UI_BASE_PACKAGES}}/ui-base-design-system"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
