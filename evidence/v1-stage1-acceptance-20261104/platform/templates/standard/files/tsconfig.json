{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM", "DOM.Iterable"
    ],
    "types": [
      "vite/client", "@ui-platform/visual-artifacts/client"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "app.settings.json"
  ]
}
