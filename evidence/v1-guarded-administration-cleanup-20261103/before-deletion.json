      "hash": "d350cf230e6c23f57039756ae5ac1c998c64ee97649960aa6b537557904e9968",
      "source": "<section class=\"uip-layout-item\" data-uip-node=\"admin_hero_empty\" data-uip-region=\"region-hero\"></section>\n<section class=\"uip-layout-item\" data-uip-node=\"admin_main\" data-uip-region=\"region-main\">\n  <h1 data-uip-node=\"admin_title\">Administration</h1>\n  <p data-uip-node=\"admin_intro\">Separate Pages and Shells reuse the same component. Shell appearance does not grant access permissions.</p>\n  <div class=\"uip-layout-item\" data-uip-node=\"admin_component_wrap\"><uip-component data-uip-node=\"admin_component\" data-uip-component=\"cmp_platform_composition-shared-help-reference\"></uip-component></div>\n</section>\n"
    },
